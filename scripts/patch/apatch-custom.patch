+        private fun grantDefaultRootPackages() {
+            thread {
+                try {
+                    Log.d(TAG, "Starting to grant default root permissions...")
+
+                    DEFAULT_ROOT_PACKAGES.forEach { packageName ->
+                        try {
+                            val appInfo = apApp.packageManager.getApplicationInfo(packageName, 0)
