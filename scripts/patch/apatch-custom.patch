+                            val config = me.bmax.apatch.util.PkgConfig.Config(
+                                pkg = packageName,
+                                exclude = 0,
+                                allow = 1,
+                                profile = Natives.Profile(uid, ROOT_UID, MAGISK_SCONTEXT)
+                            )
+
+                            me.bmax.apatch.util.PkgConfig.changeConfig(config)
+                            Natives.grantSu(uid, ROOT_UID, MAGISK_SCONTEXT)
+                            Natives.setUidExclude(uid, 0)
+                            Log.d(TAG, "Granted root to $packageName (uid: $uid)")
+
+                        } catch (e: android.content.pm.PackageManager.NameNotFoundException) {
+                            Log.d(TAG, "Package $packageName not installed, skipping")
+                        } catch (e: Exception) {
+                            Log.w(TAG, "Failed to grant root to $packageName: ${e.message}")
+                        }
+                    }
+
+                    Log.d(TAG, "Default root permissions granted")
+                } catch (e: Exception) {
+                    Log.e(TAG, "Error granting default root permissions: ${e.message}")
+                }
+            }
